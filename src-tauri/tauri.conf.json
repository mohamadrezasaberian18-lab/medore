{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MEDORE",
  "mainBinaryName": "MEDORE",
  "version": "1.0.1",
  "identifier": "app.medore.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MEDORE",
        "width": 1280,
        "height": 780,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "transparent": false,
        "backgroundColor": "#00000000",
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MEDORE",
    "copyright": "MEDORE contributors, GPL-3.0-or-later",
    "category": "Video",
    "shortDescription": "MEDORE media player",
    "longDescription": "MEDORE plays every video and music format, finds subtitles by itself, and keeps your library tidy.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../vendor/mpv/libmpv-2.dll": "libmpv-2.dll",
      "icons/medore-dark.ico": "medore-dark.ico",
      "icons/medore-light.ico": "medore-light.ico"
    },
    "fileAssociations": [
      {
        "ext": ["mkv", "mp4", "m4v", "mov", "avi", "webm", "ts", "m2ts", "mts", "flv", "wmv", "mpg", "mpeg", "vob", "3gp", "ogv", "divx", "rmvb", "asf"],
        "name": "MEDORE Video",
        "description": "Video",
        "role": "Viewer"
      },
      {
        "ext": ["mp3", "aac", "m4a", "flac", "wav", "ogg", "opus", "wma", "ape", "wv", "mka", "ac3", "dts"],
        "name": "MEDORE Audio",
        "description": "Audio",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Farsi"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1NzM1QUZGMzc0MDRCOTkKUldTWlMwQTMvMXB6WldFcUt2ZWNRL0pzcXl1S3NTTSsxbE5IckZVNGUzV1pkS3I1ZGRTUzZMTTMK",
      "endpoints": ["https://github.com/mohamadrezasaberian18-lab/medore/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
